{
  "expo": {
    "name": "Vehicle Passport",
    "slug": "vehicle-passport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vehiclepassport.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vehiclepassport.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Vehicle Passport uses the camera to photograph invoices.",
          "photosPermission": "Vehicle Passport uses your photos to attach invoice pictures."
        }
      ]
    ],
    "scheme": "vehiclepassport"
  }
}
