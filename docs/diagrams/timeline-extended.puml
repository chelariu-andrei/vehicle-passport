@startuml timeline-extended-domain
title event — domain model after the change
hide empty members

class VehicleEvent <<record>> {
  id : UUID
  vin : String
  type : EventType
  date : LocalDate
  odometerKm : Integer [0..1]
  costAmount : BigDecimal
  currency : String
  notes : String [0..1]
  customLabel : String [0..1]
  validity : Validity [0..1]
  details : EventDetails [0..1]
  components : Set<Component>
  customFields : List<CustomField>
  evidence : EvidenceLevel
  source : EventSource
}
enum EventType {
  SERVICE
  REPAIR
  TIRES
  ITP
  ROVINIETA
  INSURANCE
  SAFETY_EQUIPMENT
  OTHER
  --
  rule() : TypeRule
}
class TypeRule <<record>> {
  odometer : REQUIRED | OPTIONAL
  validity : NONE | UNTIL_OPTIONAL | UNTIL_REQUIRED | COMPUTED | RANGE
  detailsKind : DetailsKind [0..1]
  detailsRequired : boolean
  customLabelRequired : boolean
}
class Validity <<record>> {
  validFrom : LocalDate
  validUntil : LocalDate [0..1]
  {static} rovinieta(from, duration) : Validity
}
interface EventDetails <<sealed>> {
  kind() : DetailsKind
}
class ScanDetails <<record>> {
  serviceName
  parts : List<PartLine>
  labor
}
class InsuranceDetails <<record>> {
  coverage : RCA | CASCO
  insurer : String
  policyNumber : String [0..1]
}
class RovinietaDetails <<record>> {
  duration : RovinietaDuration
}
class ItpDetails <<record>> {
  station : String [0..1]
  result : ItpResult [0..1]
}
class SafetyEquipmentDetails <<record>> {
  item : FIRE_EXTINGUISHER | FIRST_AID_KIT
}
note bottom of ScanDetails
  scanned SERVICE/REPAIR/TIRES only;
  a scanned ITP gets ItpDetails
  (station = serviceName) + validUntil
end note
class EventFacts <<record>> {
  type, date, odometerKm, costAmount, currency
  customLabel, validFrom, validUntil
  details : EventDetails [0..1]
  --
  locked on a documented event
}
class EventAnnotations <<record>> {
  notes
  components : Set<Component>
  customFields : List<CustomField>
}
class CustomField <<record>> {
  label : String (1..40)
  value : String (1..200)
}
enum Component {
  ENGINE
  TRANSMISSION
  BRAKES
  SUSPENSION
  STEERING
  TIRES_WHEELS
  ELECTRICAL
  CLIMATE
  BODY
  EXHAUST
  INTERIOR
  FLUIDS
  OTHER
}
class ValidityStatusPolicy {
  {static} currentIds(validityEntries) : Set<UUID>
  {static} status(event, current : boolean, today) : ValidityStatus
  {static} group(event) : ValidityGroup [0..1]
}
enum ValidityStatus {
  VALID
  EXPIRING
  EXPIRED
  SUPERSEDED
  UNKNOWN
}

VehicleEvent --> EventType
VehicleEvent ..> EventFacts : built from
VehicleEvent ..> EventAnnotations : built from
EventType --> TypeRule
VehicleEvent --> "0..1" Validity
VehicleEvent --> "0..1" EventDetails
VehicleEvent --> "*" Component
VehicleEvent --> "0..10" CustomField
EventDetails <|.. ScanDetails
EventDetails <|.. InsuranceDetails
EventDetails <|.. RovinietaDetails
EventDetails <|.. ItpDetails
EventDetails <|.. SafetyEquipmentDetails
ValidityStatusPolicy ..> VehicleEvent
ValidityStatusPolicy ..> ValidityStatus
@enduml

@startuml timeline-extended-query-seq
title GET /vehicles/{vin}/timeline (filtered, desc)
actor Owner
participant TimelineResource
participant EventService
participant EventRepositoryPort
participant ValidityStatusPolicy
Owner -> TimelineResource : GET ?type=INSURANCE&component=..&from&to&order=desc&cursor
TimelineResource -> TimelineResource : validate enums, dates, from <= to
TimelineResource -> EventService : get(TimelineQuery)
EventService -> EventService : assert consent / visibility
EventService -> EventService : decode cursor (order must match)
alt cursor order mismatch / malformed
  TimelineResource --> Owner : 400 invalid-cursor
end
EventService -> EventRepositoryPort : page(filter, order, after, limit+1)
EventService -> EventRepositoryPort : validityEntries(vin)
loop each event
  EventService -> ValidityStatusPolicy : currentIds(validityEntries) once, then status(event, current, today)
end
EventService --> TimelineResource : TimelinePage(items, nextCursor)
TimelineResource --> Owner : 200 TimelinePage
@enduml

@startuml timeline-extended-summary-seq
title GET /vehicles/{vin}/timeline/summary
actor Owner
participant TimelineResource
participant EventService
participant EventRepositoryPort
Owner -> TimelineResource : GET ?type&component&from&to
TimelineResource -> EventService : summary(TimelineFilter)
EventService -> EventRepositoryPort : summary(filter)
note right of EventRepositoryPort
  SQL aggregates:
  * count, count by type        (all filters)
  * sum(cost) by currency       (all filters)
  * toKm   = last km in period  (period only)
  * fromKm = last km before from,
             else first km in period
  * years  = distinct years     (no filters)
end note
EventService -> EventService : km = toKm - fromKm, or null if < 2 readings
TimelineResource --> Owner : 200 TimelineSummary
@enduml

@startuml timeline-extended-add-seq
title Add event (new types)
actor Owner
participant EventResource
participant EventService
participant VehicleEvent
participant OdometerPolicy
participant EventRepositoryPort
Owner -> EventResource : POST /vehicles/{vin}/events {type, details, validity, components, customFields}
EventResource -> EventService : add(cmd)
EventService -> VehicleEvent : manual(params)
VehicleEvent -> VehicleEvent : TypeRule checks\n(odometer, validity, details kind, customLabel)
alt ROVINIETA
  VehicleEvent -> VehicleEvent : validUntil = Validity.rovinieta(validFrom, duration)
end
alt rule broken
  EventResource --> Owner : 400 validation-failed
end
opt odometerKm present
  EventService -> EventRepositoryPort : neighbours(vin, date) (km-bearing only)
  EventService -> OdometerPolicy : check(prev, km, next)
end
EventService -> EventRepositoryPort : save
EventResource --> Owner : 201 EventResponse (+ validityStatus)
@enduml

