@startuml scan
title scan — components
skinparam componentStyle rectangle

package "scan" {
  package "api" { [ScanResource] }
  package "application" {
    interface SubmitScanUseCase
    interface SubmitScanBatchUseCase
    interface ConfirmScanUseCase
    [ScanService]
    [ScanWorker]
    interface ScanJobRepositoryPort
    interface DocumentStoragePort
    interface ReceiptExtractionPort
    interface ActiveOwnerPort
    interface EventSavePort
  }
  package "domain" {
    [ScanJob]
    [ScanResult]
    [ExtractedField]
    [ReceiptValidator]
  }
  package "infrastructure" {
    [ScanJobPanacheRepository]
    [SupabaseS3StorageAdapter]
    [ExtractionAdapter] #LightYellow
    [EventFeatureAdapter]
  }
}
note right of [ExtractionAdapter] : **TO BE DISCUSSED**\nOCR / AI provider undefined.\nTests use a fake adapter.
[ScanResource] --> SubmitScanUseCase
[ScanResource] --> SubmitScanBatchUseCase
[ScanResource] --> ConfirmScanUseCase
SubmitScanUseCase <|.. [ScanService]
SubmitScanBatchUseCase <|.. [ScanService]
ConfirmScanUseCase <|.. [ScanService]
[ScanService] --> ScanJobRepositoryPort
[ScanService] --> DocumentStoragePort
[ScanService] --> ActiveOwnerPort
[ScanService] --> EventSavePort
[ScanWorker] --> ReceiptExtractionPort
[ScanWorker] --> [ReceiptValidator]
[ScanWorker] --> ScanJobRepositoryPort
ScanJobRepositoryPort <|.. [ScanJobPanacheRepository]
DocumentStoragePort <|.. [SupabaseS3StorageAdapter]
ReceiptExtractionPort <|.. [ExtractionAdapter]
EventSavePort <|.. [EventFeatureAdapter]
[EventFeatureAdapter] ..> "event.port.in\nSaveConfirmedEventUseCase"
@enduml

@startuml scan-seq
title Scan -> review -> confirm (DOCUMENTED)
actor Owner
participant ScanResource
participant ScanService
participant DocumentStoragePort as Storage
participant ScanWorker
participant ReceiptExtractionPort as OCR
participant EventSavePort
Owner -> ScanResource : POST /vehicles/{vin}/scans (file)
ScanResource -> ScanService : submit
ScanService -> Storage : put(file)
ScanService --> Owner : 202 jobId (PENDING)
ScanWorker -> OCR : extract(file)  <<TBD>>
ScanWorker -> ScanWorker : validate sums + odometer -> warnings
note right : job -> EXTRACTED
Owner -> ScanResource : GET /scans/{id}
Owner -> ScanResource : POST /scans/{id}/confirm {corrected fields}
ScanService -> EventSavePort : save(evidence=DOCUMENTED, document)
note right : job -> CONFIRMED
ScanResource --> Owner : 201 eventId
@enduml
