# Copy to .env and fill in. Never commit real values. See infra/SUPABASE-LOCAL.md.

# --- Supabase auth providers (read by infra/supabase/config.toml via env(...)) ---
# Apple (iOS only): bundle ID, optionally ",<services id>"
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
# Apple client-secret JWT (ES256, signed with the .p8 key; max 6 months)
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Google: comma-separated OAuth client IDs, web first: <web>,<ios>,<android>
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# Google web client secret
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Server ---
# Supabase base URL (OIDC + admin API); defaults to http://127.0.0.1:54321
SUPABASE_URL=
# Service role key for the account purge job (admin API). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
